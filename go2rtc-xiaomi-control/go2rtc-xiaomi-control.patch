+// RequestGet calls an API that expects an encrypted GET, like the camera APIs, and returns the decrypted
+// body as is (their answers use "data", not "result" like the miotspec ones).
+func (c *Cloud) RequestGet(baseURL, apiURL, params string) ([]byte, error) {
+	query, signedNonce, err := c.encryptQuery(apiURL, params)
+	if err != nil {
+		return nil, err
+	}
+
+	req, err := http.NewRequest("GET", baseURL+apiURL+"?"+query.Encode(), nil)
+	if err != nil {
+		return nil, err
+	}
+
+	req.Header.Set("Cookie", c.cookies)
+	req.Header.Set("MIOT-ENCRYPT-ALGORITHM", "ENCRYPT-RC4")
+	req.Header.Set("Accept-Encoding", "identity")
+
+	res, err := c.client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer res.Body.Close()
+
+	if res.StatusCode != http.StatusOK {
+		return nil, errors.New(res.Status)
+	}
+
+	body, err := io.ReadAll(res.Body)
+	if err != nil {
+		return nil, err
+	}
+
+	ciphertext, err := base64.StdEncoding.DecodeString(string(body))
+	if err != nil {
+		return nil, fmt.Errorf("xiaomi: %s", body)
+	}
+
+	return crypt(signedNonce, ciphertext)
+}
+
+// encryptQuery signs and encrypts the parameters of a GET request to the camera APIs.
+func (c *Cloud) encryptQuery(apiURL, params string) (url.Values, []byte, error) {
+	query := url.Values{"data": {params}}
+
+	nonce := genNonce()
+	signedNonce := genSignedNonce(c.ssecurity, nonce)
+
+	query.Set("rc4_hash__", genSignature64("GET", apiURL, query, signedNonce))
+
+	for _, v := range query {
+		ciphertext, err := crypt(signedNonce, []byte(v[0]))
+		if err != nil {
+			return nil, nil, err
+		}
+		v[0] = base64.StdEncoding.EncodeToString(ciphertext)
+	}
+
+	query.Set("signature", genSignature64("GET", apiURL, query, signedNonce))
+	query.Set("_nonce", base64.StdEncoding.EncodeToString(nonce))
+	return query, signedNonce, nil
+}
