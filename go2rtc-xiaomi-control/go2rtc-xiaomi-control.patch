+	data := binary.BigEndian.AppendUint32(nil, cmd)
+	data = append(data, payload...)
+	if err := c.WriteCommand(data); err != nil {
+		return nil, err
+	}
+
+	select {
+	case reply := <-c.replies:
+		return reply, nil
+	case <-time.After(wait):
+		return nil, nil
+	}
+}
