+	// Errors come back as JSON, whose length is rarely a multiple of the block size
+	if len(body) == 0 || len(body)%aes.BlockSize != 0 {
+		return nil, fmt.Errorf("xiaomi: not an encrypted image: %s", shortBody(body))
+	}
+
+	block, err := aes.NewCipher(c.ssecurity)
+	if err != nil {
+		return nil, err
+	}
+	image := make([]byte, len(body))
+	cipher.NewCBCDecrypter(block, iv).CryptBlocks(image, body)
+
+	if pad := int(image[len(image)-1]); pad >= 1 && pad <= aes.BlockSize {
+		image = image[:len(image)-pad]
+	}
+	if !bytes.HasPrefix(image, []byte{0xFF, 0xD8}) {
+		return nil, errors.New("xiaomi: the decrypted thumbnail is not a JPEG image")
+	}
+	return image, nil
+}
