{
  "pluginAlias": "XiaomiGo2rtc",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Xiaomi Mi Home cameras through go2rtc. After the first start, open the go2rtc web UI (http://SERVER-IP:1984), click Add → Xiaomi and sign in to your Xiaomi account: cameras show up automatically. Full guide: https://github.com/moguennouni/homebridge-xiaomi-go2rtc",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Xiaomi Cameras",
        "required": true
      },
      "uiUsername": {
        "title": "go2rtc web UI username",
        "type": "string",
        "description": "Strongly recommended: without it, the whole local network can watch the cameras."
      },
      "uiPassword": {
        "title": "go2rtc web UI password",
        "type": "string"
      },
      "region": {
        "title": "Xiaomi account region",
        "type": "string",
        "description": "Leave on Automatic to look in every region.",
        "oneOf": [
          {
            "title": "Automatic",
            "enum": [
              ""
            ]
          },
          {
            "title": "Europe (de)",
            "enum": [
              "de"
            ]
          },
          {
            "title": "Singapore (sg)",
            "enum": [
              "sg"
            ]
          },
          {
            "title": "United States (us)",
            "enum": [
              "us"
            ]
          },
          {
            "title": "Russia (ru)",
            "enum": [
              "ru"
            ]
          },
          {
            "title": "India (i2)",
            "enum": [
              "i2"
            ]
          },
          {
            "title": "China (cn)",
            "enum": [
              "cn"
            ]
          }
        ]
      },
      "language": {
        "title": "Language of the logs and switch names",
        "type": "string",
        "default": "auto",
        "oneOf": [
          {
            "title": "Automatic (system language)",
            "enum": [
              "auto"
            ]
          },
          {
            "title": "English",
            "enum": [
              "en"
            ]
          },
          {
            "title": "Français",
            "enum": [
              "fr"
            ]
          }
        ]
      },
      "apiPort": {
        "title": "go2rtc web UI port",
        "type": "integer",
        "default": 1984
      },
      "rtspPort": {
        "title": "go2rtc local RTSP port",
        "type": "integer",
        "default": 8554,
        "description": "Listens on 127.0.0.1 only."
      },
      "go2rtcPath": {
        "title": "Path of an installed go2rtc (advanced)",
        "type": "string",
        "description": "Leave empty: the plugin downloads and checks go2rtc-xiaomi-control, the go2rtc build released with it."
      },
      "useOfficialGo2rtc": {
        "title": "Use the official go2rtc (advanced)",
        "type": "boolean",
        "default": false,
        "description": "Downloads the official go2rtc 1.9.14 instead of go2rtc-xiaomi-control: no pan/tilt, no settings, no 16 kHz audio fix."
      },
      "ffmpegPath": {
        "title": "FFmpeg path",
        "type": "string",
        "description": "Leave empty to use ffmpeg-for-homebridge."
      },
      "cameras": {
        "title": "Camera settings",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "did": {
              "title": "Device id (did)",
              "type": "string",
              "required": true,
              "description": "Shown in the log when the camera is discovered."
            },
            "ip": {
              "title": "IP address (camera not discovered)",
              "type": "string",
              "description": "Only if the camera is not found automatically: it is then declared manually."
            },
            "region": {
              "title": "Account region (declared camera)",
              "type": "string",
              "description": "de (Europe), sg, us, ru, i2 or cn. Default: the general region, else de."
            },
            "model": {
              "title": "Xiaomi model",
              "type": "string",
              "description": "For example chuangmi.camera.026c02 (MJSXJ10CM). Required for the settings of a declared camera."
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "hidden": {
              "title": "Do not expose this camera",
              "type": "boolean",
              "default": false
            },
            "audio": {
              "title": "Audio",
              "type": "boolean",
              "default": false
            },
            "audioSampleRate": {
              "title": "Slow audio fix (official go2rtc only)",
              "type": "integer",
              "oneOf": [
                {
                  "title": "None",
                  "enum": [
                    0
                  ]
                },
                {
                  "title": "The camera sends 16 kHz audio",
                  "enum": [
                    16000
                  ]
                }
              ],
              "description": "Only if the voice sounds slow and deep with the official go2rtc. Useless, even harmful, with go2rtc-xiaomi-control, which already fixes it."
            },
            "motion": {
              "title": "Motion sensor",
              "type": "boolean",
              "default": false,
              "description": "Needs \"motion tracking\" enabled on the camera: it reports a movement when it turns to follow it."
            },
            "motionDuration": {
              "title": "Motion sensor duration (seconds)",
              "type": "integer",
              "default": 15,
              "minimum": 5,
              "maximum": 300
            },
            "videoMode": {
              "title": "Video",
              "type": "string",
              "default": "auto",
              "oneOf": [
                {
                  "title": "Automatic (copy H.264, transcode otherwise)",
                  "enum": [
                    "auto"
                  ]
                },
                {
                  "title": "Always copy",
                  "enum": [
                    "copy"
                  ]
                },
                {
                  "title": "Always transcode to H.264",
                  "enum": [
                    "transcode"
                  ]
                }
              ]
            },
            "subtype": {
              "title": "Quality requested from the camera",
              "type": "string",
              "oneOf": [
                {
                  "title": "Default",
                  "enum": [
                    ""
                  ]
                },
                {
                  "title": "HD",
                  "enum": [
                    "hd"
                  ]
                },
                {
                  "title": "SD (lighter)",
                  "enum": [
                    "sd"
                  ]
                }
              ]
            },
            "encoder": {
              "title": "H.264 encoder (transcoding)",
              "type": "string",
              "default": "libx264",
              "description": "libx264 (software) or h264_v4l2m2m (hardware, board dependent)."
            },
            "maxWidth": {
              "title": "Maximum width when transcoding",
              "type": "integer",
              "default": 1280
            },
            "settings": {
              "title": "Settings switches (standby, status light, motion tracking, motion detection, night vision)",
              "type": "boolean",
              "default": false,
              "description": "Depending on the model. A declared camera needs the right \"Xiaomi model\"."
            },
            "ptz": {
              "title": "Pan/tilt switches (motorized camera)",
              "type": "boolean",
              "default": false,
              "description": "They work while the live view is open."
            },
            "ptzPanSteps": {
              "title": "Steps per press, left / right",
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "maximum": 20,
              "description": "One horizontal step is small: increase it to turn more on each press."
            },
            "ptzTiltSteps": {
              "title": "Steps per press, up / down",
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "maximum": 20
            },
            "ptzLeft": {
              "title": "\"Left\" command (advanced)",
              "type": "string",
              "placeholder": "{\"operation\":2}"
            },
            "ptzRight": {
              "title": "\"Right\" command (advanced)",
              "type": "string",
              "placeholder": "{\"operation\":1}"
            },
            "ptzUp": {
              "title": "\"Up\" command (advanced)",
              "type": "string",
              "placeholder": "{\"operation\":4}"
            },
            "ptzDown": {
              "title": "\"Down\" command (advanced)",
              "type": "string",
              "placeholder": "{\"operation\":3}"
            }
          }
        }
      }
    }
  }
}
